# Copie para .env (nunca versionar o .env).
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Postgres do docker compose local (infrastructure/docker-compose.yml) exposto na porta 55432.
DATABASE_URL=postgresql://imperio:imperio@localhost:55432/imperio
# Banco separado usado pelos testes automatizados (é apagado a cada execução).
TEST_DATABASE_URL=postgresql://imperio:imperio@localhost:55432/imperio_test
# Gere um valor aleatório: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=1h
STARTING_COINS=100
