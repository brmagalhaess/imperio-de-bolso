// Império de Bolso — esquema do banco (PostgreSQL).
// A API é a autoridade econômica: saldos em BIGINT, toda mudança passa pelo ledger.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  COINS
  GEMS
}

model Player {
  id                  String    @id @default(uuid()) @db.Uuid
  guestId             String    @unique @map("guest_id") @db.Uuid
  guestSecretHash     String    @map("guest_secret_hash")
  displayName         String    @map("display_name")
  // Troca de nome permitida uma única vez (Perfil).
  nameChangedAt       DateTime? @map("name_changed_at") @db.Timestamptz(3)
  // Prestígio (ADR 0011): estrelas de investidor = bônus permanente de lucro.
  prestigeStars       Int       @default(0) @map("prestige_stars")
  prestigeCount       Int       @default(0) @map("prestige_count")
  lastPrestigeAt      DateTime? @map("last_prestige_at") @db.Timestamptz(3)
  tutorialCompletedAt DateTime? @map("tutorial_completed_at") @db.Timestamptz(3)
  // Presença por mapa (ADR 0006): mapa aberto agora e último sinal do jogo.
  currentDistrict     String?   @map("current_district")
  lastSeenAt          DateTime? @map("last_seen_at") @db.Timestamptz(3)
  // Auto-coleta no mapa aberto (Loja, ADR 0008): comprada com diamantes até esta data;
  // o Passe VIP ativo também liga.
  autoCollectUntil    DateTime? @map("auto_collect_until") @db.Timestamptz(3)
  // Último AFK pago ao voltar a um mapa (para o anúncio "dobrar" — uma vez por resumo).
  lastAfkTotal        BigInt    @default(0) @map("last_afk_total")
  lastAfkAt           DateTime? @map("last_afk_at") @db.Timestamptz(3)
  lastAfkDoubled      Boolean   @default(false) @map("last_afk_doubled")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  wallet         PlayerWallet?
  businesses     PlayerBusiness[]
  ledger         WalletLedger[]
  idempotency    IdempotencyRecord[]
  missions       PlayerMission[]
  achievements   PlayerAchievement[]
  events         AnalyticsEvent[]
  receipts       PurchaseReceipt[]
  subscriptions  Subscription[]
  adRewards      AdReward[]
  vipDailyClaims VipDailyClaim[]

  @@map("players")
}

model PlayerWallet {
  playerId  String   @id @map("player_id") @db.Uuid
  coins     BigInt   @default(0)
  gems      BigInt   @default(0)
  version   Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_wallets")
}

model WalletLedger {
  id             BigInt   @id @default(autoincrement())
  playerId       String   @map("player_id") @db.Uuid
  currency       Currency
  delta          BigInt
  balanceAfter   BigInt   @map("balance_after")
  reason         String
  // Único globalmente: "<player_id>:<chave>" impede crédito/débito duplicado.
  idempotencyKey String?  @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
  @@index([reason, createdAt])
  @@map("wallet_ledger")
}

model BusinessDefinition {
  id            Int    @id @default(autoincrement())
  slug          String @unique
  name          String
  sortOrder     Int    @map("sort_order")
  // Distrito do mapa (ordem em src/economy/districts.ts): praia → cidade.
  district      String @default("praia")
  cost          BigInt
  revenue       BigInt
  operatingCost BigInt @default(0) @map("operating_cost")
  cycleSeconds  Int    @map("cycle_seconds")
  // Preço do ajudante (gerente da doc) que automatiza a produção.
  managerCost   BigInt @default(0) @map("manager_cost")
  maxLevel      Int    @default(100) @map("max_level")
  config        Json   @default("{}")

  players PlayerBusiness[]

  @@map("business_definitions")
}

model PlayerBusiness {
  playerId         String    @map("player_id") @db.Uuid
  businessId       Int       @map("business_id")
  level            Int       @default(1)
  managerUnlocked  Boolean   @default(false) @map("manager_unlocked")
  // Ciclo manual: início do ciclo em andamento (null = parado aguardando ação).
  cycleStartedAt   DateTime? @map("cycle_started_at") @db.Timestamptz(3)
  // Com ajudante: sobra de tempo (ms) entre liquidações — docs/README.md §7.
  carryMs          Int       @default(0) @map("carry_ms")
  lastSettlementAt DateTime  @default(now()) @map("last_settlement_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  player   Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  business BusinessDefinition @relation(fields: [businessId], references: [id])

  @@id([playerId, businessId])
  @@map("player_businesses")
}

// Respostas de comandos econômicos, para repetir a mesma resposta quando o
// cliente reenviar o mesmo Idempotency-Key (rede instável, toque duplo).
model IdempotencyRecord {
  playerId     String   @map("player_id") @db.Uuid
  key          String
  route        String
  requestHash  String   @map("request_hash")
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, key])
  @@map("idempotency_records")
}

// Missões diárias (docs/README.md §3/§10): 3 por jogador por dia (horário de Brasília).
model PlayerMission {
  id          String    @id @default(uuid()) @db.Uuid
  playerId    String    @map("player_id") @db.Uuid
  day         String // AAAA-MM-DD em America/Sao_Paulo
  template    String
  target      BigInt
  progress    BigInt    @default(0)
  rewardCoins BigInt    @map("reward_coins")
  rewardGems  Int       @map("reward_gems")
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, day, template])
  @@index([playerId, day])
  @@map("player_missions")
}

model PlayerAchievement {
  playerId      String    @map("player_id") @db.Uuid
  achievementId String    @map("achievement_id")
  unlockedAt    DateTime  @default(now()) @map("unlocked_at") @db.Timestamptz(3)
  claimedAt     DateTime? @map("claimed_at") @db.Timestamptz(3)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, achievementId])
  @@map("player_achievements")
}

// Eventos de analytics (docs/README.md §13). Sem dados pessoais nas propriedades.
model AnalyticsEvent {
  id        BigInt   @id @default(autoincrement())
  playerId  String?  @map("player_id") @db.Uuid
  name      String
  props     Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([playerId, createdAt])
  @@map("analytics_events")
}

// Compras (doc §10): um recibo por transação da loja; sandbox/mock até as lojas estarem prontas.
model PurchaseReceipt {
  id              String    @id @default(uuid()) @db.Uuid
  // Nulo depois da exclusão da conta (ADR 0009): o recibo fica, sem dado pessoal, para
  // impedir reuso do mesmo recibo e para tratar reembolsos.
  playerId        String?   @map("player_id") @db.Uuid
  store           String // mock | google | apple
  transactionId   String    @map("transaction_id")
  productId       String    @map("product_id")
  status          String // VERIFIED | REVOKED
  gemsGranted     BigInt    @default(0) @map("gems_granted")
  // Diamantes que não puderam ser retirados no reembolso (já gastos).
  revokeShortfall BigInt    @default(0) @map("revoke_shortfall")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)

  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([store, transactionId])
  @@map("purchase_receipts")
}

model Subscription {
  id            String    @id @default(uuid()) @db.Uuid
  // Nulo depois da exclusão da conta (ADR 0009); "restaurar" religa a uma conta nova.
  playerId      String?   @map("player_id") @db.Uuid
  productId     String    @map("product_id")
  store         String
  transactionId String    @map("transaction_id")
  status        String // ACTIVE | REVOKED
  startsAt      DateTime  @map("starts_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)

  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([store, transactionId])
  @@index([playerId, expiresAt])
  @@map("subscriptions")
}

// Anúncio recompensado: sessão criada antes de exibir; o servidor só paga depois de verificada
// (SSV do AdMob com assinatura em produção; confirmação mock só em desenvolvimento).
model AdReward {
  id            String    @id @default(uuid()) @db.Uuid
  playerId      String    @map("player_id") @db.Uuid
  placement     String // ad_boost | offline_double
  district      String?
  rewardCoins   BigInt    @default(0) @map("reward_coins")
  status        String // PENDING | VERIFIED | CLAIMED | EXPIRED
  transactionId String?   @unique @map("transaction_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz(3)
  claimedAt     DateTime? @map("claimed_at") @db.Timestamptz(3)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, placement, createdAt])
  @@map("ad_rewards")
}

// Recompensa diária do Passe VIP (diamantes): um resgate por dia do jogo (Brasília).
model VipDailyClaim {
  playerId  String   @map("player_id") @db.Uuid
  day       String
  gems      Int
  claimedAt DateTime @default(now()) @map("claimed_at") @db.Timestamptz(3)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, day])
  @@map("vip_daily_claims")
}
