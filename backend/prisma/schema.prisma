// Império de Bolso — esquema do banco (PostgreSQL).
// A API é a autoridade econômica: saldos em BIGINT, toda mudança passa pelo ledger.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  COINS
  GEMS
}

model Player {
  id                  String    @id @default(uuid()) @db.Uuid
  guestId             String    @unique @map("guest_id") @db.Uuid
  guestSecretHash     String    @map("guest_secret_hash")
  displayName         String    @map("display_name")
  // Troca de nome permitida uma única vez (Perfil).
  nameChangedAt       DateTime? @map("name_changed_at") @db.Timestamptz(3)
  // Prestígio (ADR 0011): estrelas de investidor = bônus permanente de lucro.
  prestigeStars       Int       @default(0) @map("prestige_stars")
  prestigeCount       Int       @default(0) @map("prestige_count")
  lastPrestigeAt      DateTime? @map("last_prestige_at") @db.Timestamptz(3)
  // Conta da equipe (testes no aparelho de desenvolvimento): fica fora de todos os rankings e
  // pódios para não concorrer com os jogadores. Ligada pelo painel admin.
  staff               Boolean   @default(false) @map("is_staff")
  // Aparelho e versão do jogo da última abertura (painel: de qual loja vêm os jogadores).
  platform            String? // ios | android
  appVersion          String?   @map("app_version")
  tutorialCompletedAt DateTime? @map("tutorial_completed_at") @db.Timestamptz(3)
  // Presença por mapa (ADR 0006): mapa aberto agora e último sinal do jogo.
  currentDistrict     String?   @map("current_district")
  lastSeenAt          DateTime? @map("last_seen_at") @db.Timestamptz(3)
  // Auto-coleta no mapa aberto (Loja, ADR 0008): comprada com diamantes até esta data;
  // o Passe VIP ativo também liga.
  autoCollectUntil    DateTime? @map("auto_collect_until") @db.Timestamptz(3)
  // Turbo da Loja (ADR 0013): produção 2× de turboFrom até turboUntil.
  turboFrom           DateTime? @map("turbo_from") @db.Timestamptz(3)
  turboUntil          DateTime? @map("turbo_until") @db.Timestamptz(3)
  // Dobro de moedas (ADR 0025): toda a produção ×2 de doubleFrom até doubleUntil.
  doubleFrom          DateTime? @map("double_from") @db.Timestamptz(3)
  doubleUntil         DateTime? @map("double_until") @db.Timestamptz(3)
  // Último AFK pago ao voltar a um mapa (para o anúncio "dobrar" — uma vez por resumo).
  lastAfkTotal        BigInt    @default(0) @map("last_afk_total")
  lastAfkAt           DateTime? @map("last_afk_at") @db.Timestamptz(3)
  lastAfkDoubled      Boolean   @default(false) @map("last_afk_doubled")
  // Retenção (ADR 0014): calendário de 7 dias (dia da sequência e último dia resgatado) e baú
  // das missões do dia.
  loginStreak         Int       @default(0) @map("login_streak")
  lastLoginRewardDay  String?   @map("last_login_reward_day")
  missionChestDay     String?   @map("mission_chest_day")
  // Pódio semanal (ADR 0017): última semana já conferida para prêmios de 1º/2º/3º lugar.
  rewardsCheckedWeek  String?   @map("rewards_checked_week")
  // ADR 0035: quantos mapas estão liberados (na ordem). NULL = jogador antigo ainda não
  // convertido (o servidor grava o que ele já tinha aberto). Não volta ao vender o império.
  unlockedMaps        Int?      @default(1) @map("unlocked_maps")
  // Estrelas de evolução acumuladas (1 por evolução de negócio; NULL = ainda não contadas).
  evoStars            Int?      @map("evo_stars")
  // Temporada de 20 dias: última já conferida para prêmios.
  rewardsCheckedSeason Int?     @map("rewards_checked_season")
  // Convide amigos (ADR 0035): quem convidou e quando o convite rendeu prêmio a quem convidou.
  invitedBy           String?   @map("invited_by") @db.Uuid
  inviteRewardedAt    DateTime? @map("invite_rewarded_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  wallet         PlayerWallet?
  businesses     PlayerBusiness[]
  ledger         WalletLedger[]
  idempotency    IdempotencyRecord[]
  missions       PlayerMission[]
  achievements   PlayerAchievement[]
  events         AnalyticsEvent[]
  receipts       PurchaseReceipt[]
  subscriptions  Subscription[]
  adRewards      AdReward[]
  vipDailyClaims VipDailyClaim[]
  leagueWeeks    PlayerLeagueWeek[]
  gameEvents     PlayerEvent[]
  identities     PlayerIdentity[]
  reportsMade     PlayerReport[] @relation("reporter")
  reportsReceived PlayerReport[] @relation("reported")
  weeklyRewards  PlayerWeeklyReward[]
  seasons        PlayerSeason[]

  @@index([invitedBy])
  @@map("players")
}

model PlayerWallet {
  playerId  String   @id @map("player_id") @db.Uuid
  coins     BigInt   @default(0)
  gems      BigInt   @default(0)
  version   Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_wallets")
}

model WalletLedger {
  id             BigInt   @id @default(autoincrement())
  playerId       String   @map("player_id") @db.Uuid
  currency       Currency
  delta          BigInt
  balanceAfter   BigInt   @map("balance_after")
  reason         String
  // Único globalmente: "<player_id>:<chave>" impede crédito/débito duplicado.
  idempotencyKey String?  @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
  @@index([reason, createdAt])
  @@map("wallet_ledger")
}

model BusinessDefinition {
  id            Int    @id @default(autoincrement())
  slug          String @unique
  name          String
  sortOrder     Int    @map("sort_order")
  // Distrito do mapa (ordem em src/economy/districts.ts): praia → cidade.
  district      String @default("praia")
  cost          BigInt
  revenue       BigInt
  operatingCost BigInt @default(0) @map("operating_cost")
  cycleSeconds  Int    @map("cycle_seconds")
  // Preço do ajudante (gerente da doc) que automatiza a produção.
  managerCost   BigInt @default(0) @map("manager_cost")
  maxLevel      Int    @default(100) @map("max_level")
  config        Json   @default("{}")

  players PlayerBusiness[]

  @@map("business_definitions")
}

model PlayerBusiness {
  playerId         String    @map("player_id") @db.Uuid
  businessId       Int       @map("business_id")
  level            Int       @default(1)
  managerUnlocked  Boolean   @default(false) @map("manager_unlocked")
  // Nível do ajudante (ADR 0035): 0 = sem ajudante, 1 = contratado … 10.
  managerLevel     Int       @default(0) @map("manager_level")
  // Ciclo manual: início do ciclo em andamento (null = parado aguardando ação).
  cycleStartedAt   DateTime? @map("cycle_started_at") @db.Timestamptz(3)
  // Com ajudante: sobra de tempo (ms) entre liquidações — docs/README.md §7.
  carryMs          Int       @default(0) @map("carry_ms")
  lastSettlementAt DateTime  @default(now()) @map("last_settlement_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  player   Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  business BusinessDefinition @relation(fields: [businessId], references: [id])

  @@id([playerId, businessId])
  @@map("player_businesses")
}

// Respostas de comandos econômicos, para repetir a mesma resposta quando o
// cliente reenviar o mesmo Idempotency-Key (rede instável, toque duplo).
model IdempotencyRecord {
  playerId     String   @map("player_id") @db.Uuid
  key          String
  route        String
  requestHash  String   @map("request_hash")
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, key])
  @@map("idempotency_records")
}

// Missões diárias (docs/README.md §3/§10): 3 por jogador por dia (horário de Brasília).
model PlayerMission {
  id          String    @id @default(uuid()) @db.Uuid
  playerId    String    @map("player_id") @db.Uuid
  day         String // AAAA-MM-DD em America/Sao_Paulo
  template    String
  target      BigInt
  progress    BigInt    @default(0)
  rewardCoins BigInt    @map("reward_coins")
  rewardGems  Int       @map("reward_gems")
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, day, template])
  @@index([playerId, day])
  @@map("player_missions")
}

model PlayerAchievement {
  playerId      String    @map("player_id") @db.Uuid
  achievementId String    @map("achievement_id")
  unlockedAt    DateTime  @default(now()) @map("unlocked_at") @db.Timestamptz(3)
  claimedAt     DateTime? @map("claimed_at") @db.Timestamptz(3)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, achievementId])
  @@map("player_achievements")
}

// Eventos de analytics (docs/README.md §13). Sem dados pessoais nas propriedades.
model AnalyticsEvent {
  id        BigInt   @id @default(autoincrement())
  playerId  String?  @map("player_id") @db.Uuid
  name      String
  props     Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([playerId, createdAt])
  @@map("analytics_events")
}

// Compras (doc §10): um recibo por transação da loja; sandbox/mock até as lojas estarem prontas.
model PurchaseReceipt {
  id              String    @id @default(uuid()) @db.Uuid
  // Nulo depois da exclusão da conta (ADR 0009): o recibo fica, sem dado pessoal, para
  // impedir reuso do mesmo recibo e para tratar reembolsos.
  playerId        String?   @map("player_id") @db.Uuid
  store           String // mock | google | apple
  transactionId   String    @map("transaction_id")
  productId       String    @map("product_id")
  status          String // VERIFIED | REVOKED
  // Compra sem cobrança: Sandbox da Apple, testador licenciado do Google ou loja "mock". Fica
  // registrada (entrega igual), mas não entra na receita nem nas estatísticas do painel.
  test            Boolean   @default(false)
  gemsGranted     BigInt    @default(0) @map("gems_granted")
  // Diamantes que não puderam ser retirados no reembolso (já gastos).
  revokeShortfall BigInt    @default(0) @map("revoke_shortfall")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)

  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([store, transactionId])
  @@map("purchase_receipts")
}

model Subscription {
  id            String    @id @default(uuid()) @db.Uuid
  // Nulo depois da exclusão da conta (ADR 0009); "restaurar" religa a uma conta nova.
  playerId      String?   @map("player_id") @db.Uuid
  productId     String    @map("product_id")
  store         String
  transactionId String    @map("transaction_id")
  status        String // ACTIVE | REVOKED
  // Assinatura de teste (mesma regra do recibo): não conta em "assinantes ativos" do painel.
  test          Boolean   @default(false)
  startsAt      DateTime  @map("starts_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)

  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([store, transactionId])
  @@index([playerId, expiresAt])
  @@map("subscriptions")
}

// Anúncio recompensado: sessão criada antes de exibir; o servidor só paga depois de verificada
// (SSV do AdMob com assinatura em produção; confirmação mock só em desenvolvimento).
model AdReward {
  id            String    @id @default(uuid()) @db.Uuid
  playerId      String    @map("player_id") @db.Uuid
  placement     String // ad_boost | offline_double
  district      String?
  rewardCoins   BigInt    @default(0) @map("reward_coins")
  status        String // PENDING | VERIFIED | CLAIMED | EXPIRED
  transactionId String?   @unique @map("transaction_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz(3)
  claimedAt     DateTime? @map("claimed_at") @db.Timestamptz(3)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, placement, createdAt])
  @@map("ad_rewards")
}

// Recompensa diária do Passe VIP (diamantes): um resgate por dia do jogo (Brasília).
model VipDailyClaim {
  playerId  String   @map("player_id") @db.Uuid
  day       String
  gems      Int
  claimedAt DateTime @default(now()) @map("claimed_at") @db.Timestamptz(3)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, day])
  @@map("vip_daily_claims")
}

/// Liga semanal do jogador (ADR 0014): definida na primeira visita da semana, a partir da
/// posição na liga da semana anterior (sobe os 20% do topo, desce os 20% de baixo).
model PlayerLeagueWeek {
  playerId String @map("player_id") @db.Uuid
  week     String // segunda-feira da semana, AAAA-MM-DD (Brasília)
  league   Int
  // Grupo por vendas do império (0 = nunca vendeu … 5 = 5 ou mais), fixo durante a semana.
  bracket  Int    @default(0)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, week])
  @@index([week, bracket, league])
  @@map("player_league_weeks")
}

/// Evento de fim de semana (ADR 0014): mapa com lucro 2× e meta de faturamento com prêmio.
model PlayerEvent {
  playerId  String    @map("player_id") @db.Uuid
  eventId   String    @map("event_id")
  district  String
  target    BigInt
  claimedAt DateTime? @map("claimed_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, eventId])
  @@map("player_events")
}

/// Conta vinculada (ADR 0015): "Entrar com Google/Apple" para recuperar o progresso em outro
/// aparelho. `subject` é o id estável do usuário no provedor (claim "sub"); e-mail e nome
/// não são guardados (LGPD: só o necessário).
model PlayerIdentity {
  provider  String
  subject   String
  playerId  String   @map("player_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([provider, subject])
  @@unique([playerId, provider])
  @@map("player_identities")
}

/// Prêmio do pódio da semana (ADR 0017): 1º, 2º e 3º lugar no ranking geral e na liga.
model PlayerWeeklyReward {
  playerId  String    @map("player_id") @db.Uuid
  week      String // segunda-feira da semana premiada, AAAA-MM-DD (Brasília)
  kind      String // "semana" (ranking geral) ou "liga"
  rank      Int
  league    Int?
  gems      Int
  // Bônus da semana (ADR 0026): "turbo" | "auto" | "boost" (horas) ou nulo.
  bonusKind  String? @map("bonus_kind")
  bonusHours Int     @default(0) @map("bonus_hours")
  claimedAt DateTime? @map("claimed_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, week, kind])
  @@map("player_weekly_rewards")
}

/// Temporada de 20 dias (ADR 0035): estrelas de evolução ganhas pelo jogador na temporada.
model PlayerSeason {
  playerId  String   @map("player_id") @db.Uuid
  season    Int
  stars     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, season])
  @@index([season, stars])
  @@map("player_seasons")
}

/// Denúncia de nome impróprio no ranking (diretriz 1.2 da Apple): um por denunciante e alvo.
/// Com 3 denunciantes diferentes o nome escolhido volta ao padrão (resolvedAt marca isso).
model PlayerReport {
  reporterId String    @map("reporter_id") @db.Uuid
  reportedId String    @map("reported_id") @db.Uuid
  reason     String    @default("name")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)

  reporter Player @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported Player @relation("reported", fields: [reportedId], references: [id], onDelete: Cascade)

  @@id([reporterId, reportedId])
  @@index([reportedId])
  @@map("player_reports")
}
