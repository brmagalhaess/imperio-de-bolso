; Engine configuration file.
; Império de Bolso — Godot 4.7, GDScript, 2D isométrico, retrato 9:16.

config_version=5

[application]

config/name="Império de Bolso"
config/description="Idle tycoon isométrico 2D"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/app_icon/icon_512.png"
boot_splash/bg_color=Color(0.0471, 0.5412, 0.5216, 1)
boot_splash/image="res://assets/app_icon/adaptive_fg_432.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]

Api="*res://scripts/api_client.gd"
GameState="*res://scripts/game_state.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[imperio]

api/base_url="http://127.0.0.1:3000/api/v1"
api/base_url_mobile="https://api-imperio.crowntech.com.br/api/v1"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=true
