# Variáveis do ambiente local. O backend lê backend/.env (veja backend/.env.example).
# Para o docker compose (infrastructure/docker-compose.yml), opcional:
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Higgsfield (open.higgsfield.ai / cloud.higgsfield.ai) — geração de arte, só na sua máquina.
# Formato do SDK oficial: <key_id>:<key_secret>. Nunca colocar no jogo nem no Git.
HF_KEY=
