# Variáveis da stack no Dockploy (cole na aba Environment; NUNCA versione os valores reais).
# Gere cada segredo com: openssl rand -hex 32
STACK_ENV=staging
POSTGRES_PASSWORD=
JWT_SECRET=
# Opcional: liga o painel admin somente leitura.
ADMIN_TOKEN=
# Frase dos backups criptografados. Guarde uma cópia FORA do servidor (gerenciador de senhas):
# sem ela os backups não podem ser restaurados.
BACKUP_PASSPHRASE=
BACKUP_KEEP=14
BACKUP_CRON=30 3 * * *
# live/admob exigem as integrações reais (ADR 0008). Enquanto não existem, o teste fechado
# (staging) usa STORE_MODE=mock, ADS_MODE=mock e BETA_SANDBOX=true: nada é cobrado.
# A stack de PRODUÇÃO pública deve ficar com BETA_SANDBOX=false.
STORE_MODE=live
ADS_MODE=admob
BETA_SANDBOX=false
# Contas vinculadas (ADR 0015) — "Entrar com Google/Apple". Vazio = desligado.
# GOOGLE_CLIENT_IDS: client ids OAuth (Android/Web) separados por vírgula.
# APPLE_AUDIENCES: bundle id do app iOS (ex.: br.com.imperiodebolso.game).
GOOGLE_CLIENT_IDS=
APPLE_AUDIENCES=br.com.imperiodebolso.game
# Versão 1.0 (ADR 0018): compras em R$ e anúncios. Em produção o padrão é desligado.
# PURCHASES_ENABLED=false
# ADS_ENABLED=false
